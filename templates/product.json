            "tabs_and_faq": {
              "type": "custom-liquid",
              "name": "Benefits, Details & FAQ",
              "settings": {
                "custom_liquid": "<style>\n.mk-tabs{margin:20px 0}\n.mk-tabs__nav{display:flex;gap:4px;border-bottom:1px solid rgba(24,58,43,.15);margin-bottom:14px}\n.mk-tabs__btn{background:none;border:none;padding:10px 16px;font-size:.9rem;font-weight:600;color:rgba(24,58,43,.5);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;font-family:inherit}\n.mk-tabs__btn.is-active{color:#183A2B;border-bottom-color:#A8472E}\n.mk-tabs__panel[hidden]{display:none}\n.mk-benefits-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}\n.mk-benefits-list li{display:flex;align-items:center;gap:8px;font-size:.9rem;color:#183A2B}\n.mk-benefits-list li svg{width:16px;height:16px;color:#1a7a4c;flex-shrink:0}\n.mk-tabs__panel p{margin:0;font-size:.9rem;color:rgba(24,58,43,.75);line-height:1.6}\n\n.mk-faq{margin:24px 0}\n.mk-faq h3{font-size:1.05rem;font-weight:700;color:#183A2B;margin:0 0 10px}\n.mk-faq__item{border-bottom:1px solid rgba(24,58,43,.12)}\n.mk-faq__q{width:100%;display:flex;justify-content:space-between;align-items:center;background:none;border:none;padding:12px 0;font-size:.88rem;font-weight:600;color:#183A2B;cursor:pointer;text-align:left;font-family:inherit}\n.mk-faq__q span{font-size:1.1rem;color:#A8472E;flex-shrink:0;margin-left:12px}\n.mk-faq__item.is-open .mk-faq__q span{transform:rotate(45deg)}\n.mk-faq__a{padding:0 0 14px;font-size:.86rem;color:rgba(24,58,43,.75);line-height:1.6}\n.mk-faq__a[hidden]{display:none}\n</style>\n\n<div class=\"mk-tabs\">\n  <div class=\"mk-tabs__nav\">\n    <button type=\"button\" class=\"mk-tabs__btn is-active\" data-tab=\"benefits\">Benefits</button>\n    <button type=\"button\" class=\"mk-tabs__btn\" data-tab=\"details\">Product Details</button>\n  </div>\n  <div class=\"mk-tabs__panel\" data-panel=\"benefits\">\n    <ul class=\"mk-benefits-list\">\n      <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"/></svg> No Preservatives</li>\n      <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"/></svg> Traditional Recipe</li>\n      <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"/></svg> Kerala Made</li>\n      <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"/></svg> Small Batch</li>\n    </ul>\n  </div>\n  <div class=\"mk-tabs__panel\" data-panel=\"details\" hidden>\n    <p>{{ product.description | strip_html }}</p>\n  </div>\n</div>\n\n<div class=\"mk-faq\">\n  <h3>Questions?</h3>\n  <div class=\"mk-faq__item\">\n    <button type=\"button\" class=\"mk-faq__q\">Do you offer Cash on Delivery?<span>+</span></button>\n    <div class=\"mk-faq__a\" hidden><p>Yes, COD is available on eligible orders at checkout.</p></div>\n  </div>\n  <div class=\"mk-faq__item\">\n    <button type=\"button\" class=\"mk-faq__q\">How long does shipping take?<span>+</span></button>\n    <div class=\"mk-faq__a\" hidden><p>Orders are typically delivered within 4–7 business days.</p></div>\n  </div>\n  <div class=\"mk-faq__item\">\n    <button type=\"button\" class=\"mk-faq__q\">How should I store this product?<span>+</span></button>\n    <div class=\"mk-faq__a\" hidden><p>Store in a cool, dry place away from direct sunlight. Once opened, keep the pack tightly sealed to preserve freshness.</p></div>\n  </div>\n  <div class=\"mk-faq__item\">\n    <button type=\"button\" class=\"mk-faq__q\">Is this authentic to Kerala?<span>+</span></button>\n    <div class=\"mk-faq__a\" hidden><p>Yes — prepared following traditional Kerala recipes and methods, in small batches.</p></div>\n  </div>\n</div>\n\n<script>\n  (function(){\n    document.querySelectorAll('.mk-tabs__btn').forEach(function(btn){\n      btn.addEventListener('click', function(){\n        var tabs = btn.closest('.mk-tabs');\n        tabs.querySelectorAll('.mk-tabs__btn').forEach(function(b){ b.classList.remove('is-active'); });\n        btn.classList.add('is-active');\n        tabs.querySelectorAll('.mk-tabs__panel').forEach(function(p){ p.hidden = p.dataset.panel !== btn.dataset.tab; });\n      });\n    });\n    document.querySelectorAll('.mk-faq__q').forEach(function(q){\n      q.addEventListener('click', function(){\n        var item = q.closest('.mk-faq__item');\n        var isOpen = item.classList.toggle('is-open');\n        item.querySelector('.mk-faq__a').hidden = !isOpen;\n      });\n    });\n  })();\n</script>\n"
