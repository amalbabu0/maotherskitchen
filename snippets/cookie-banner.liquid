<div id="cookie-banner" class="cookie-banner" hidden>
  <div class="cookie-banner__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M21 12.5A8.5 8.5 0 1 1 11.5 4a1 1 0 0 0 1.1 1.4 2.5 2.5 0 0 0 3 3A1 1 0 0 0 17 9.5a2.5 2.5 0 0 0 3 3 1 1 0 0 0 1 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="9" cy="11" r="1" fill="currentColor"/>
      <circle cx="13" cy="15" r="1" fill="currentColor"/>
      <circle cx="9.5" cy="15.5" r="1" fill="currentColor"/>
    </svg>
  </div>
  <div class="cookie-banner__body">
    <p class="cookie-banner__heading">We respect your privacy</p>
    <p class="cookie-banner__text">
      This website uses cookies to ensure you get the best experience.
      <a href="{{ 'privacy-policy' | shop_locale_url: 'policies' }}">Learn more</a>
    </p>
  </div>
  <button type="button" class="cookie-banner__accept" id="cookie-banner-accept">Accept</button>
</div>

<script>
  (function () {
    var STORAGE_KEY = 'mk_cookie_consent';
    if (localStorage.getItem(STORAGE_KEY) === 'accepted') return;
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;
    banner.hidden = false;
    document.getElementById('cookie-banner-accept').addEventListener('click', function () {
      localStorage.setItem(STORAGE_KEY, 'accepted');
      banner.hidden = true;
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 2rem;
    background: #ffffff;
    color: #111111;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.08);
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner__icon { flex-shrink: 0; width: 28px; height: 28px; }
  .cookie-banner__icon svg { width: 100%; height: 100%; }
  .cookie-banner__body { flex-grow: 1; }
  .cookie-banner__heading { margin: 0 0 0.3rem; font-size: 1.4rem; font-weight: 700; color: #111111; }
  .cookie-banner__text { margin: 0; font-size: 1.3rem; color: #333333; }
  .cookie-banner__text a { color: inherit; text-decoration: underline; }
  .cookie-banner__accept {
    flex-shrink: 0;
    background: #111111;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0.9rem 2rem;
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
  }
  .cookie-banner__accept:hover { opacity: 0.85; }

  @media screen and (max-width: 749px) {
    .cookie-banner { flex-wrap: wrap; padding: 1.2rem 1.6rem; }
    .cookie-banner__accept { width: 100%; }
  }
</style>
