{%- doc -%}
  Renders a heart button that saves/removes a product from the visitor's
  wishlist (stored in localStorage, no account or app required).

  @param {object} product - The product to save
  @param {string} [class] - Extra class(es) for positioning

  @example
  {% render 'wishlist-toggle', product: product %}
{%- enddoc -%}

<script src="{{ 'wishlist.js' | asset_url }}" type="module"></script>

<wishlist-button class="wishlist-toggle {{ class }}" data-handle="{{ product.handle }}">
  <button type="button" class="wishlist-toggle__control" aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false">
    <svg class="wishlist-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 21s-7.5-4.6-10-9.3C.5 8 2 4 6 4c2.2 0 3.7 1.3 4.5 2.6C11.3 5.3 12.8 4 15 4c4 0 5.5 4 4 7.7C19.5 16.4 12 21 12 21z"/>
    </svg>
  </button>
</wishlist-button>

{% stylesheet %}
  .wishlist-toggle__control {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 247, 232, 0.92);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .wishlist-toggle__control:hover { transform: scale(1.08); }
  .wishlist-toggle__icon {
    width: 18px;
    height: 18px;
    color: #16241C;
    transition: color 0.15s ease, fill 0.15s ease;
  }
  .wishlist-toggle.is-saved .wishlist-toggle__icon {
    fill: #A8472E;
    stroke: #A8472E;
  }
{% endstylesheet %}
