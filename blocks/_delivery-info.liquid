<div class="delivery-info">
  {%- if block.settings.line_1 != blank -%}
    <div class="delivery-info__row">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 7h13v9H1V7Z" stroke="currentColor" stroke-width="1.5"/><path d="M14 10h4l4 3.5V16h-8v-6Z" stroke="currentColor" stroke-width="1.5"/><circle cx="5.5" cy="18.5" r="1.5" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="18.5" r="1.5" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>{{ block.settings.line_1 }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.line_2 != blank -%}
    <div class="delivery-info__row">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="10" width="18" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 10V7a5 5 0 0 1 10 0v3" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>{{ block.settings.line_2 }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.line_3 != blank -%}
    <div class="delivery-info__row">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" stroke="currentColor" stroke-width="1.5"/><path d="M3 3v5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{{ block.settings.line_3 }}</span>
    </div>
  {%- endif -%}
</div>

<style>
  .delivery-info {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 8px;
  }
  .delivery-info__row { display: flex; align-items: center; gap: 0.6rem; font-size: 1.3rem; }
  .delivery-info__row svg { width: 20px; height: 20px; flex-shrink: 0; opacity: 0.8; }
</style>

{% schema %}
{
  "name": "Delivery info box",
  "settings": [
    { "type": "text", "id": "line_1", "label": "Line 1", "default": "Free delivery on orders above ₹499" },
    { "type": "text", "id": "line_2", "label": "Line 2", "default": "Cash on Delivery (COD) available" },
    { "type": "text", "id": "line_3", "label": "Line 3", "default": "Easy 7-day return policy" }
  ]
}
{% endschema %}
