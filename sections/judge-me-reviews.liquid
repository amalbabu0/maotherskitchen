{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign testimonial_count = 0
  for block in section.blocks
    if block.type == 'testimonial'
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

<div class="color-custom-{{ section.id }} judgeme-reviews" data-judgeme-reviews-section>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="judgeme-reviews__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="judgeme-reviews__subheading">{{ section.settings.subheading }}</p>{%- endif -%}

    <ul class="judgeme-reviews__grid" role="list" data-testimonial-track hidden></ul>
    <div class="judgeme-reviews__dots" data-testimonial-dots aria-hidden="true" hidden></div>
    <p class="judgeme-reviews__empty" data-testimonial-empty hidden>No reviews yet — be the first to leave one on any product page.</p>

    {%- comment -%} Fallback example content, used only if no real reviews exist anywhere {%- endcomment -%}
    <template data-testimonial-fallback>
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          <li class="judgeme-reviews__card" data-rating="{{ block.settings.rating }}" data-author="{{ block.settings.author | escape }}" data-product="{{ block.settings.product_name | escape }}" data-quote="{{ block.settings.quote | escape }}"></li>
        {%- endif -%}
      {%- endfor -%}
    </template>

    {%- comment -%} Real Judge.me review data, one hidden source block per product, parsed client-side {%- endcomment -%}
    <div hidden data-judgeme-sources>
      {%- for p in collections.all.products -%}
        {%- if p.metafields.judgeme.widget != blank -%}
          <div data-jdgm-source>{{ p.metafields.judgeme.widget.value }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'judgeme-reviews.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  .judgeme-reviews { padding-block: 4.5rem; text-align: center; }
  .judgeme-reviews__heading { margin: 0 0 0.5rem; font-size: 2.25rem; font-weight: 700; }
  .judgeme-reviews__subheading { opacity: 0.65; margin: 0 auto 2.75rem; max-width: 480px; font-size: 1.05rem; }
  .judgeme-reviews__empty { opacity: 0.6; }

  .judgeme-reviews__grid {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 1rem;
    text-align: left;
    scrollbar-width: none;
  }
  .judgeme-reviews__grid::-webkit-scrollbar { display: none; }
  .judgeme-reviews__card { flex: 0 0 min(88vw, 340px); scroll-snap-align: center; }

  .judgeme-reviews__card {
    background: var(--color-background, #fff);
    border: 1px solid rgba(24,58,43,0.1);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    box-shadow: 0 4px 20px rgba(24,58,43,0.06);
  }
  .judgeme-reviews__quote-icon { width: 34px; height: 26px; color: #A8472E; opacity: 0.35; }
  .judgeme-reviews__stars { display: flex; gap: 2px; color: #D99A2B; margin-top: -0.4rem; }
  .judgeme-reviews__stars svg { width: 16px; height: 16px; }
  .judgeme-reviews__quote { margin: 0; font-size: 1rem; line-height: 1.6; flex-grow: 1; opacity: 0.85; }

  .judgeme-reviews__person { display: flex; align-items: center; gap: 12px; margin-top: 0.4rem; }
  .judgeme-reviews__avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #D99A2B;
    color: #183A2B;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .judgeme-reviews__person-text { display: flex; flex-direction: column; gap: 1px; }
  .judgeme-reviews__author { margin: 0; font-weight: 700; font-size: 0.95rem; }
  .judgeme-reviews__location { margin: 0; font-size: 0.82rem; color: #A8472E; font-weight: 600; }
  .judgeme-reviews__product { margin: 0; font-size: 0.8rem; opacity: 0.55; }

  .judgeme-reviews__dots { display: flex; justify-content: center; gap: 8px; margin-top: 1.75rem; }
  .judgeme-reviews__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(24,58,43,0.2);
    padding: 0;
    cursor: pointer;
  }
  .judgeme-reviews__dot.is-active { background: #A8472E; width: 20px; border-radius: 4px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Judge.me reviews",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Read real feedback from customers who love our food and trust our quality." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial (fallback)",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review text", "default": "Absolutely delicious and tastes just like home-made." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Happy Customer" },
        { "type": "text", "id": "product_name", "label": "Product (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Judge.me reviews", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }
  ]
}
{% endschema %}
