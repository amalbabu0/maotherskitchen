{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign testimonial_count = 0
  for block in section.blocks
    if block.type == 'testimonial'
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

<div class="color-custom-{{ section.id }} judgeme-reviews">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="judgeme-reviews__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="judgeme-reviews__subheading">{{ section.settings.subheading }}</p>{%- endif -%}

    {%- if testimonial_count > 0 -%}
      <ul class="judgeme-reviews__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <li class="judgeme-reviews__card" {{ block.shopify_attributes }}>
              <div class="judgeme-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <p class="judgeme-reviews__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
              <p class="judgeme-reviews__author">
                {{ block.settings.author }}
                {%- if block.settings.product_name != blank -%}<span class="judgeme-reviews__product"> &middot; {{ block.settings.product_name }}</span>{%- endif -%}
              </p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="judgeme-reviews__app-slot">
      {%- content_for 'blocks' -%}
    </div>

    {%- if section.blocks.size == 0 -%}
      <p class="judgeme-reviews__empty">
        Placeholder. Once Judge.me is installed, add its "All Reviews Widget" / carousel app block to this section from the theme editor (this section accepts app blocks).
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .judgeme-reviews { padding-block: 4rem; text-align: center; }
  .judgeme-reviews__heading { margin: 0 0 0.5rem; }
  .judgeme-reviews__subheading { opacity: 0.75; margin: 0 0 2rem; }
  .judgeme-reviews__empty { opacity: 0.6; }
  .judgeme-reviews__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    text-align: left;
  }
  @media screen and (min-width: 750px) {
    .judgeme-reviews__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .judgeme-reviews__card {
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .judgeme-reviews__stars { display: flex; gap: 2px; color: #D99A2B; }
  .judgeme-reviews__stars svg { width: 16px; height: 16px; }
  .judgeme-reviews__quote { margin: 0; font-size: 1.4rem; line-height: 1.5; flex-grow: 1; }
  .judgeme-reviews__author { margin: 0; font-weight: 600; font-size: 1.3rem; }
  .judgeme-reviews__product { font-weight: 400; opacity: 0.65; }
{% endstylesheet %}

{% schema %}
{
  "name": "Judge.me reviews",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Our Customers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real experiences from customers who enjoy our products." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review text", "default": "Absolutely delicious and tastes just like home-made." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Happy Customer" },
        { "type": "text", "id": "product_name", "label": "Product (optional)" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Judge.me reviews", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }
  ]
}
{% endschema %}
