{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign bg_product = section.blocks.first.settings.product
%}

<div class="color-custom-{{ section.id }} bundle-promo-banner">
  {%- if bg_product.featured_image -%}
    <div class="bundle-promo-banner__bg">
      {{ bg_product.featured_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}
  <div class="page-width bundle-promo-banner__inner">
    <div class="bundle-promo-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bundle-promo-banner__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="bundle-promo-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="bundle-promo-banner__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button bundle-promo-banner__button--mobile">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link | default: '#' }}" class="button bundle-promo-banner__button--floating">
      {{ section.settings.button_label }}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .bundle-promo-banner { position: relative; overflow: hidden; }
  .bundle-promo-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bundle-promo-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bundle-promo-banner__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(24, 58, 43, 0.94) 0%, rgba(24, 58, 43, 0.75) 45%, rgba(24, 58, 43, 0.35) 100%);
  }
  .bundle-promo-banner__inner {
    position: relative;
    z-index: 1;
    padding-block: 80px;
  }
  .bundle-promo-banner__content { max-width: 46rem; }
  .bundle-promo-banner__eyebrow { letter-spacing: 0.1em; text-transform: uppercase; font-size: 1.3rem; opacity: 0.85; margin: 0 0 0.5rem; }
  .bundle-promo-banner__heading { margin: 0 0 1rem; }
  .bundle-promo-banner .button {
    background: #D99A2B !important;
    border-color: #D99A2B !important;
    color: #16241C !important;
  }
  .bundle-promo-banner__button--mobile {
    display: block;
    width: fit-content;
    margin-inline: auto;
  }
  .bundle-promo-banner__button--floating {
    display: none;
  }
  @media screen and (min-width: 750px) {
    .bundle-promo-banner__button--mobile { display: none; }
    .bundle-promo-banner__button--floating {
      display: block;
      position: absolute;
      z-index: 2;
      right: 12%;
      top: 50%;
      transform: translateY(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle promo banner",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#183A2B" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "COMPLETE YOUR FAVOURITES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Save More With Our Combo Offers" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Combine your favourite products and enjoy special bundle pricing.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Combos" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "presets": [
    { "name": "Bundle promo banner", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }
  ]
}
{% endschema %}
