{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="color-custom-{{ section.id }} trust-bar">
  <div class="page-width">
    <ul class="trust-bar__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          <svg class="trust-bar__icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 20 20">
            {%- render 'icon', icon: block.settings.icon -%}
          </svg>
          <p class="trust-bar__heading">{{ block.settings.heading }}</p>
          {%- if block.settings.text != blank -%}
            <p class="trust-bar__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .trust-bar { padding-block: 40px; }
  .trust-bar__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .trust-bar__item { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .trust-bar__icon { flex-shrink: 0; color: {{ settings.color_palette.foreground | default: '#183A2B' }}; }
  .trust-bar__heading { margin: 0; font-size: 1.6rem; font-weight: 600; }
  .trust-bar__text { margin: 0; font-size: 1.3rem; opacity: 0.75; }

  @media screen and (max-width: 749px) {
    .trust-bar__grid { flex-wrap: nowrap; gap: 6px; }
    .trust-bar__item { gap: 6px; }
    .trust-bar__icon { width: 22px; height: 22px; }
    .trust-bar__heading { font-size: 1.1rem; line-height: 1.2; }
    .trust-bar__text { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon name (e.g. leaf, lock, check_box, truck)", "default": "leaf" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Authentic Products" },
        { "type": "text", "id": "text", "label": "Description (hidden on mobile)", "default": "Carefully selected quality products" }
      ]
    }
  ],
  "presets": [
    { "name": "Trust bar", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }
  ]
}
{% endschema %}
