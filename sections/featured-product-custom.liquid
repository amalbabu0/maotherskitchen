{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign product = section.settings.product
%}

<div class="color-custom-{{ section.id }} featured-product-custom">
  <div class="page-width featured-product-custom__inner">
    <div class="featured-product-custom__media">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'featured-product-custom__placeholder' }}
      {%- endif -%}
    </div>
    <div class="featured-product-custom__details">
      {%- if section.settings.eyebrow != blank -%}<p class="featured-product-custom__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="featured-product-custom__title">{{ product.title }}</h2>
      <p class="featured-product-custom__price">
        {{ product.price | money }}
        {%- if product.compare_at_price > product.price -%}
          <s class="featured-product-custom__compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </p>
      {%- if product.description != blank -%}
        <div class="featured-product-custom__description">{{ product.description | strip_html | truncatewords: 30 }}</div>
      {%- endif -%}
      <a href="{{ product.url }}" class="button featured-product-custom__button">View Product</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .featured-product-custom { padding-block: 3rem; }
  .featured-product-custom__inner { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }
  @media screen and (min-width: 750px) { .featured-product-custom__inner { grid-template-columns: 1fr 1fr; } }
  .featured-product-custom__media { aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; background: rgba(0,0,0,0.05); }
  .featured-product-custom__media img, .featured-product-custom__placeholder { width: 100%; height: 100%; object-fit: cover; }
  .featured-product-custom__eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 1.3rem; opacity: 0.7; margin: 0 0 0.5rem; }
  .featured-product-custom__title { margin: 0 0 0.75rem; }
  .featured-product-custom__price { font-size: 1.8rem; margin: 0 0 1rem; }
  .featured-product-custom__compare { opacity: 0.6; margin-left: 0.5rem; font-size: 1.4rem; }
  .featured-product-custom__description { opacity: 0.8; margin: 0 0 1.5rem; line-height: 1.5; }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Featured" },
    { "type": "product", "id": "product", "label": "Product" }
  ],
  "presets": [
    { "name": "Featured product" }
  ]
}
{% endschema %}
