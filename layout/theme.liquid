<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    <style>
      main[data-template="collection"],
      main[data-template="list-collections"],
      main[data-template="cart"],
      main[data-template="search"],
      main[data-template="404"],
      main[data-template="blog"],
      main[data-template="article"],
      main[data-template="product"],
      #header-component:not([transparent]),
      #header-component[data-sticky-state="active"],
      footer {
        background-image: url({{ 'site-background.png' | asset_url }});
        background-repeat: repeat;
        background-size: 620px;
      }
      #header-component:not([transparent]) .header__underlay,
      #header-component[data-sticky-state="active"] .header__underlay,
      footer .section-background {
        background-color: color-mix(in srgb, var(--color-background) 45%, transparent) !important;
      }
      main[data-template="collection"] .section-background,
      main[data-template="collection"] .main-collection-grid,
      main[data-template="list-collections"] .section-background,
      main[data-template="cart"] .section-background,
      main[data-template="search"] .section-background,
      main[data-template="search"] .main-collection-grid,
      main[data-template="404"] .section-background,
      main[data-template="blog"] .section-background,
      main[data-template="blog"] .blog-post-item,
      main[data-template="article"] .section-background,
      main[data-template="product"] .section-background,
      main[data-template="product"] .judgeme-reviews {
        background-color: color-mix(in srgb, var(--color-background) 45%, transparent) !important;
      }
      main[data-template="collection"] .product-card__content,
      main[data-template="search"] .product-card__content,
      main[data-template="product"] .product-card__content {
        background-color: color-mix(in srgb, var(--color-background) 60%, transparent) !important;
      }
      @media screen and (min-width: 990px) {
        main[data-template="article"] .image-block {
          max-width: 936px;
          margin-inline: auto;
        }
      }
      @media screen and (max-width: 749px) {
        main[data-template="collection"] .main-collection-grid {
          padding-left: 1rem;
        }
      }
      .featured-product-custom__media {
        border-radius: 0 !important;
      }
      /* Product page wishlist + share icons: on mobile only, pin them over
         the image (stacked, like a typical mobile PDP) via pure CSS (no DOM
         move — moving it into the media/product component subtree was
         triggering Horizon's own re-render of those custom elements, which
         silently double-bound the wishlist button's click handler on every
         disconnect/reconnect). The media and details columns share a
         common grid ancestor (product-component), which becomes the
         positioning anchor; the wishlist block's own generic flex-item
         wrapper divs default to position:relative in Horizon and would
         otherwise intercept that anchoring first, so they're forced back
         to static, scoped narrowly via :has() to this one block. On
         desktop none of this applies — the icons stay inline near the
         title, side by side. */
      .product-action-icons {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
      }
      @media screen and (max-width: 749px) {
        main[data-template="product"] product-component.product-information__grid {
          position: relative;
          z-index: 2;
        }
        main[data-template="product"] .group-block:has(.product-action-icons),
        main[data-template="product"] .group-block-content:has(.product-action-icons) {
          position: static !important;
        }
        /* The icons' own flex-item wrapper (a plain, unstyled div Horizon
           generates per custom-liquid block) still reserves a full flex
           "gap" on each side even once its content is pulled out with
           position:absolute — leaving an empty gap where the block used to
           be. Taking the wrapper itself out of flow removes that gap; the
           icons render statically inside it as normal. */
        main[data-template="product"] div:has(> .product-action-icons) {
          position: absolute !important;
          top: 10px;
          right: 10px;
          z-index: 999;
          isolation: isolate;
        }
        main[data-template="product"] .product-action-icons {
          position: static;
          flex-direction: column;
          margin-top: 0;
        }
        /* Same empty-gap issue for the invisible helper blocks (a <style>
           tag and the hidden recently-viewed tracker) that sit between the
           title and the benefit pills — collapse them out of the flex flow
           entirely since they render no visible content either way. */
        main[data-template="product"] div:has(> style:only-child),
        main[data-template="product"] div:has(> recently-viewed-tracker) {
          display: none;
        }
      }
      main[data-template="index"] [id*="trust_bar"] .trust-bar,
      main[data-template="index"] [id*="product_list"] .section-background,
      main[data-template="index"] [id*="17885122455f935fcd"] .section-background,
      main[data-template="index"] [id*="reviews"] .judgeme-reviews,
      main[data-template="index"] [id*="featured_blog"] .section-background,
      main[data-template="index"] [id*="featured_product"] .featured-product-custom,
      main[data-template="index"] .collection-bento {
        background-image:
          linear-gradient(color-mix(in srgb, var(--color-background) 55%, transparent), color-mix(in srgb, var(--color-background) 55%, transparent)),
          url({{ 'site-background.png' | asset_url }}) !important;
        background-repeat: no-repeat, repeat !important;
        background-size: cover, 620px !important;
      }
      html {
        scroll-behavior: smooth;
      }
      #shopify-section-template--28474060243312__collection_tiles {
        scroll-margin-top: 100px;
      }
    </style>

    {%- assign bg_image_policy_pages = 'privacy-policy,terms-privacy,shipping-policy,refund-policy,about,contact,wishlist,faqs' | split: ',' -%}
    {%- if template == 'page' and bg_image_policy_pages contains page.handle -%}
      <style>
        main[data-template="page"] {
          background-image: url({{ 'site-background.png' | asset_url }});
          background-repeat: repeat;
          background-size: 620px;
        }
        main[data-template="page"] .section-background {
          background-color: color-mix(in srgb, var(--color-background) 45%, transparent) !important;
        }
        main[data-template="page"] .contact-form-box,
        main[data-template="page"] .contact-card {
          background-color: color-mix(in srgb, white 60%, transparent) !important;
        }
        main[data-template="page"] [class*="video-block"] {
          background-color: color-mix(in srgb, var(--color-background) 45%, transparent) !important;
        }
        main[data-template="page"] #fs-message {
          height: 4rem;
          resize: none;
        }
      </style>
    {%- endif -%}

    {%- if template == 'page' and page.handle == 'about' -%}
      <style>
        /* About page bottom image block: bleed full width (no side gutter) and cap its height.
           Targeted by the block's own id (image_nimPzq) rather than the image filename, since
           the uploaded image gets swapped from the theme editor independently of this block. */
        main[data-template="page"] .section--page-width:has([class*="image_nimPzq"]) {
          grid-template-columns: 0 1fr 0 !important;
        }
        main[data-template="page"] [class*="image_nimPzq"] img {
          max-height: 420px !important;
          width: 100%;
          object-fit: cover;
        }
      </style>
    {%- endif -%}

    <style>
      /* Sticky nav: fade between transparent and solid instead of snapping */
      #header-component,
      #header-component .header__underlay {
        transition: background-color 0.35s ease, background-image 0.35s ease;
      }

      /* Add to Cart button pulse */
      .btn-pulse {
        animation: add-to-cart-pulse 0.45s ease;
      }
      @keyframes add-to-cart-pulse {
        0% { transform: scale(1); }
        35% { transform: scale(0.94); }
        65% { transform: scale(1.05); }
        100% { transform: scale(1); }
      }

      /* Cart icon bump, driven by the existing cart-bubble--animating state */
      .header-actions__cart-icon:has(.cart-bubble--animating) svg {
        animation: cart-icon-bump 0.45s ease;
      }
      @keyframes cart-icon-bump {
        0% { transform: scale(1) rotate(0deg); }
        30% { transform: scale(1.25) rotate(-8deg); }
        60% { transform: scale(0.95) rotate(4deg); }
        100% { transform: scale(1) rotate(0deg); }
      }

      /* Scroll-triggered reveal for trust bar, Why Choose Us, and blog cards */
      .reveal-on-scroll {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .reveal-on-scroll.is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      /* Soft shimmer placeholder while product/blog images load */
      img.img-loading {
        background: linear-gradient(90deg, #f0ead8 25%, #faf5e8 50%, #f0ead8 75%);
        background-size: 200% 100%;
        animation: image-shimmer 1.3s ease-in-out infinite;
      }
      @keyframes image-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        .btn-pulse,
        .header-actions__cart-icon:has(.cart-bubble--animating) svg,
        img.img-loading {
          animation: none;
        }
        .reveal-on-scroll {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
    <script src="{{ 'site-animations.js' | asset_url }}" type="module" defer></script>
    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        /**
         * Sets `--header-height` and `--header-group-height` to measured values before first paint.
         *
         * A few CSS rules position content relative to the header at first paint — a hero sized to
         * the remaining viewport, a transparent header's negative margin. Without a measured value
         * those rules use the `60px` fallback from `sections/header.liquid`, and the content visibly
         * jumps once `header.js` corrects the values after load.
         *
         * Measuring forces layout mid-parse, so it only runs where a consuming rule exists.
         * Callers opt in: the transparent-header branch below, or `snippets/measure-header-heights.liquid`,
         * which any new first-paint consumer must render too.
         *
         * Measures once per page; after load, header.js's ResizeObservers keep the values fresh.
         * The group-height walk mimics calculateHeaderGroupHeight() in utilities.js — keep them
         * in sync.
         */
        window.measureHeaderHeights = (function () {
          let measured = false;

          return function measureHeaderHeights() {
            if (measured) return;

            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');

            if (!header || !headerGroup) return;
            measured = true;

            const headerHeight = header.offsetHeight;

            let headerGroupHeight = 0;
            for (const element of headerGroup.children) {
              if (element instanceof HTMLElement) headerGroupHeight += element.offsetHeight;
            }

            /**
             * A transparent header is absolutely positioned, so the loop above counts its section
             * wrapper as 0px. When a section follows it in the group, header.liquid pushes that
             * section down by the header's height using a margin, which offsetHeight also
             * excludes — so the header's height has to be added back manually.
             */
            if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          };
        })();

        /**
         * Transparent-header rules consume the measured heights at first paint on every
         * template, so the transparent case opts in globally here instead of per-section.
         */
        if (document.querySelector('#header-component')?.hasAttribute('transparent')) {
          measureHeaderHeights();
        }

        /**
         * Sets `--top-row-height`, consumed by the header underlays and submenus. Deferred to a
         * rAF so the height read doesn't force layout mid-parse, and scoped to the
         * header, where all consumers live, so the write only invalidates the header subtree.
         * Mimics the `--top-row-height` write in updateHeaderHeights() in utilities.js
         */
        (function setTopRowHeight() {
          const header = document.querySelector('#header-component');
          const headerTopRow = header?.querySelector('.header__row--top');
          if (!headerTopRow) return;

          window.requestAnimationFrame(function () {
            header.style.setProperty('--top-row-height', `${headerTopRow.getBoundingClientRect().height}px`);
          });
        })();

        /**
         * Sets `--transparent-header-offset-boolean` when the first section must offset itself
         * under a transparent header. The non-offset case relies on the `0` default declared in
         * sections/header.liquid — unlike updateTransparentHeaderOffset() in utilities.js, which
         * re-runs on editor changes and must write '0' to reset a previously written '1'.
         */
        (function updateTransparentHeaderOffset() {
          const header = document.querySelector('#header-component');
          const headerSection = document.querySelector('#header-group .header-section');
          if (!headerSection || !header?.hasAttribute('transparent')) return;

          const hasImmediateSection = headerSection.nextElementSibling?.classList.contains('shopify-section');
          if (!hasImmediateSection) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '1');
          }
        })();

        /**
         * Sets the initial menu style (inline menu vs. drawer) on the header component.
         * Mimics setHeaderMenuStyle() in utilities.js
         */
        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% render 'cookie-banner' %}
  </body>
</html>
